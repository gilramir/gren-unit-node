module Main exposing ( main )

import Node
import Test.Runner.UnitNode as U
import GlobTests
import RunnerTests


main : Node.SimpleProgram {}
main =
    U.run
        { name = "gren-unit-node-tests"
        , version = "1.0.0"
        , suites =
            [ GlobTests.suite
            , RunnerTests.lifecycleSuite
            , RunnerTests.selectionSuite
            ]
        }
