module Main exposing (main)

import Node
import Task exposing (Task)
import Test.Runner.UnitNode as U
import GlobTests
import RunnerTests


main : Task Never {}
main =
    Node.getEnvironment
        |> Task.andThen
            (\env ->
                U.run env
                    { name = "gren-unit-node-tests"
                    , version = "1.0.0"
                    , suites =
                        [ GlobTests.suite
                        , RunnerTests.lifecycleSuite
                        , RunnerTests.selectionSuite
                        ]
                    }
            )
