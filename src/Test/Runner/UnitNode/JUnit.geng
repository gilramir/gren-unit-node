module Test.Runner.UnitNode.JUnit exposing (toXmlString)

{-| Serialize results to the de-facto JUnit XML schema that CI systems
(Jenkins, GitLab, GitHub Actions reporters, …) understand:

    <testsuites>
      <testsuite name="Format" tests="3" failures="1" errors="0" time="0.042">
        <testcase classname="Format" name="imports" time="0.012"/>
        <testcase classname="Format" name="exprs" time="0.030">
          <failure message="expected: 1&#10;actual: 2"/>
        </testcase>
      </testsuite>
    </testsuites>

`time` is seconds (millis / 1000), formatted with three decimals. All attribute
and text values are XML-escaped. This is pure string building over the same
`SuiteResult` array the console reporter consumes — nothing effectful here; the
caller does the `FileSystem.writeFile`.
-}

import Test.Runner.UnitNode.Internal as I exposing (Outcome(..), SuiteResult, TestResult)


toXmlString : Array SuiteResult -> String
toXmlString suiteResults =
    String.join
        "\n"
        [ "<?xml version=\"1.0\" encoding=\"UTF-8\"?>"
        , "<testsuites>"
        , suiteResults |> Array.map suiteXml |> String.join "\n"
        , "</testsuites>"
        ]


suiteXml : SuiteResult -> String
suiteXml sr =
    let
        tests =
            Array.length sr.results

        failures =
            sr.results |> countWhere isFailed

        errors =
            (sr.results |> countWhere isErrored)
                + (when sr.suiteError is
                    Just _ ->
                        1

                    Nothing ->
                        0
                  )

        seconds =
            sr.results
                |> Array.foldl (\r acc -> acc + r.durationMs) 0
                |> secondsString
    in
    String.join
        "\n"
        [ "  <testsuite name=\""
            ++ escape sr.name
            ++ "\" tests=\""
            ++ String.fromInt tests
            ++ "\" failures=\""
            ++ String.fromInt failures
            ++ "\" errors=\""
            ++ String.fromInt errors
            ++ "\" time=\""
            ++ seconds
            ++ "\">"
        , (Array.map caseXml sr.results ++ [ suiteErrorXml sr.suiteError ])
            |> Array.keepIf (\s -> s /= "")
            |> String.join "\n"
        , "  </testsuite>"
        ]


caseXml : TestResult -> String
caseXml r =
    let
        open =
            "    <testcase classname=\""
                ++ escape r.suiteName
                ++ "\" name=\""
                ++ escape r.name
                ++ "\" time=\""
                ++ secondsString r.durationMs
                ++ "\""
    in
    when r.outcome is
        Passed ->
            open ++ "/>"

        Failed m ->
            open ++ ">\n      <failure message=\"" ++ escape m ++ "\"/>\n    </testcase>"

        Errored m ->
            open ++ ">\n      <error message=\"" ++ escape m ++ "\"/>\n    </testcase>"


suiteErrorXml : Maybe String -> String
suiteErrorXml maybeErr =
    when maybeErr is
        Just e ->
            "    <testcase classname=\"\" name=\"<suite lifecycle>\">\n      <error message=\""
                ++ escape e
                ++ "\"/>\n    </testcase>"

        Nothing ->
            ""


countWhere : (Outcome -> Bool) -> Array TestResult -> Int
countWhere pred results =
    results
        |> Array.foldl
            (\r acc ->
                if pred r.outcome then
                    acc + 1

                else
                    acc
            )
            0


secondsString : Int -> String
secondsString ms =
    let
        whole =
            ms // 1000

        frac =
            ms - (whole * 1000)
    in
    String.fromInt whole ++ "." ++ String.padLeft 3 '0' (String.fromInt frac)


escape : String -> String
escape s =
    s
        |> String.replace "&" "&amp;"
        |> String.replace "<" "&lt;"
        |> String.replace ">" "&gt;"
        |> String.replace "\"" "&quot;"
        |> String.replace "\n" "&#10;"


isFailed : Outcome -> Bool
isFailed outcome =
    when outcome is
        Failed _ ->
            True

        _ ->
            False


isErrored : Outcome -> Bool
isErrored outcome =
    when outcome is
        Errored _ ->
            True

        _ ->
            False
