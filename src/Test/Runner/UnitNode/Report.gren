module Test.Runner.UnitNode.Report exposing (Style(..), suiteLine, verboseLine, tail)

{-| Rendering for the console report. The report is emitted in two parts, and
the split is what makes live output possible:

* **the body** — [suiteLine](#suiteLine) and [verboseLine](#verboseLine), each a
  *pure function of one result*. Nothing about a line depends on any other
  suite or test (the column widths below are constants, not measured across the
  run), so `Program` prints them as results land and gets output byte-identical
  to rendering everything at the end.
* **the tail** — [tail](#tail): the failure/error detail blocks and the summary
  counts. This genuinely needs every result, so it is the one thing that waits
  for the run to finish.

Two styles, mirroring `python -m unittest` and `… -v`:

* `Plain` — one line per **suite** (name, status, passed/total, duration).
* `Verbose` — one line per **test** with its fully-qualified name, status, and
  wall-clock duration, with the suite's line repeated after its tests as a
  rollup that closes the block.

Color is applied with raw ANSI when `useColor` is set (green pass / red fail /
yellow error), matching how the rest of this workspace gates color on an
interactive terminal + absence of `NO_COLOR`.
-}

import Test.Runner.UnitNode.Internal as I exposing (Outcome(..), SuiteResult, TestResult)


type Style
    = Plain
    | Verbose


{-| The end-of-run part of the report: detail blocks for every failure and
error, then the summary counts. The caller has already printed the body line by
line, and is responsible for the blank lines that separate it from this.
-}
tail : { useColor : Bool } -> Array SuiteResult -> String
tail opts suiteResults =
    let
        allResults =
            suiteResults
                |> Array.foldl (\sr acc -> acc ++ sr.results) []

        suiteErrors =
            suiteResults
                |> Array.foldl
                    (\sr acc ->
                        when sr.suiteError is
                            Just e ->
                                Array.pushLast (sr.name ++ ": " ++ e) acc

                            Nothing ->
                                acc
                    )
                    []

        failures =
            allResults |> Array.keepIf (\r -> isFailed r.outcome)

        errors =
            allResults |> Array.keepIf (\r -> isErrored r.outcome)

        passed =
            allResults |> Array.keepIf (\r -> not (isFailed r.outcome || isErrored r.outcome))

        totalMs =
            allResults |> Array.foldl (\r acc -> acc + r.durationMs) 0
    in
    [ detailBlock "FAIL" failures
    , detailBlock "ERROR" errors
    , suiteErrorBlock suiteErrors
    , summaryLine { total = Array.length allResults
        , passed = Array.length passed
        , failures = Array.length failures
        , errors = Array.length errors + Array.length suiteErrors
        , totalMs = totalMs
        , useColor = opts.useColor
        }
    ]
        |> Array.keepIf (\s -> s /= "")
        |> String.join "\n\n\n"


{-| One suite's body line: name, status, passed/total, total duration. In
`Plain` this is the whole body; in `Verbose` it is the rollup printed after the
suite's own test lines.
-}
suiteLine : Bool -> SuiteResult -> String
suiteLine useColor sr =
    let
        { tag, col } =
            if sr.suiteError /= Nothing || Array.any (\r -> isErrored r.outcome) sr.results then
                { tag = "ERROR", col = yellow }

            else if Array.any (\r -> isFailed r.outcome) sr.results then
                { tag = "FAIL", col = red }

            else
                { tag = "ok", col = green }

        total =
            Array.length sr.results

        passed =
            sr.results
                |> Array.foldl
                    (\r acc ->
                        if isFailed r.outcome || isErrored r.outcome then
                            acc

                        else
                            acc + 1
                    )
                    0

        durationMs =
            Array.foldl (\r acc -> acc + r.durationMs) 0 sr.results

        counts =
            String.fromInt passed ++ "/" ++ String.fromInt total
    in
    String.padRight 52 ' ' sr.name
        ++ " "
        ++ color useColor col (String.padRight 6 ' ' tag)
        ++ String.padRight 7 ' ' counts
        ++ "("
        ++ String.fromInt durationMs
        ++ " ms)"


{-| One test's body line in `Verbose`: fully-qualified name, status, duration.
-}
verboseLine : Bool -> TestResult -> String
verboseLine useColor r =
    let
        name =
            r.suiteName ++ "." ++ r.name

        { tag, col } =
            when r.outcome is
                Passed ->
                    { tag = "ok", col = green }

                Failed _ ->
                    { tag = "FAIL", col = red }

                Errored _ ->
                    { tag = "ERROR", col = yellow }
    in
    String.padRight 52 ' ' name
        ++ " "
        ++ color useColor col (String.padRight 6 ' ' tag)
        ++ "("
        ++ String.fromInt r.durationMs
        ++ " ms)"


detailBlock : String -> Array TestResult -> String
detailBlock label results =
    if Array.isEmpty results then
        ""

    else
        results
            |> Array.map
                (\r ->
                    "=== " ++ label ++ ": " ++ r.suiteName ++ "." ++ r.name ++ " ===\n" ++ messageOf r.outcome
                )
            |> String.join "\n\n"


suiteErrorBlock : Array String -> String
suiteErrorBlock errs =
    if Array.isEmpty errs then
        ""

    else
        "=== SUITE ERRORS ===\n" ++ String.join "\n" errs


summaryLine :
    { total : Int, passed : Int, failures : Int, errors : Int, totalMs : Int, useColor : Bool }
    -> String
summaryLine s =
    let
        ran =
            "Ran " ++ String.fromInt s.total ++ " tests in " ++ String.fromInt s.totalMs ++ " ms"
    in
    if s.failures == 0 && s.errors == 0 then
        ran ++ "\n\n" ++ color s.useColor green ("OK — " ++ String.fromInt s.passed ++ " passed")

    else
        ran
            ++ "\n\n"
            ++ color
                s.useColor
                red
                ("FAILED — "
                    ++ String.fromInt s.passed
                    ++ " passed, "
                    ++ String.fromInt s.failures
                    ++ " failed, "
                    ++ String.fromInt s.errors
                    ++ " errored")


messageOf : Outcome -> String
messageOf outcome =
    when outcome is
        Passed ->
            ""

        Failed m ->
            m

        Errored m ->
            m


isFailed : Outcome -> Bool
isFailed outcome =
    when outcome is
        Failed _ ->
            True

        _ ->
            False


isErrored : Outcome -> Bool
isErrored outcome =
    when outcome is
        Errored _ ->
            True

        _ ->
            False

-- ANSI


color : Bool -> String -> String -> String
color useColor code text =
    if useColor then
        code ++ text ++ "\u{001b}[0m"

    else
        text


green : String
green =
    "\u{001b}[32m"


red : String
red =
    "\u{001b}[31m"


yellow : String
yellow =
    "\u{001b}[33m"
