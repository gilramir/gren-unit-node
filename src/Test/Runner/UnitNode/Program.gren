module Test.Runner.UnitNode.Program exposing (run, runWith)

{-| The CLI entry point. `run` and `runWith` build a complete `Node.SimpleProgram`
on top of `gilramir/gren-argparse`, so a test executable's `main` is a one-liner.

`run` is the convenience form: it acquires `FileSystem` and `ChildProcess`
permissions and passes them to your suite builder as `Permissions`. Use
`runWith` when you need a different set of permissions — or none at all.

CLI surface:

    my-tests                       # run everything
    my-tests 'Format.*'            # run only tests whose qualified name globs
    my-tests '*in place*' 'Glob.*' # multiple patterns: union
    my-tests -v                    # verbose: per-test status + timing
    my-tests --list                # print every test's qualified name and exit
    my-tests --junit-xml out.xml   # also write JUnit results to out.xml

Output is **live**: a suite's line is printed the moment that suite finishes,
and under `-v` a test's line the moment that test finishes, so a run that takes
a while shows progress instead of going quiet and dumping everything at the end.
Only the failure details and the summary counts wait for the run to complete —
they are the only parts that need every result. See `runAll` and `Report`.

Exit code is `0` only if every selected test passed (argparse's `Succeeded`);
any failure/error yields `Failed` → exit `1`, after the report is printed. A
bad flag or a `--junit-xml` write failure fails the task → exit `1` with a
diagnostic on stderr, exactly the Unix split `Argparse.Program` already bakes in.
-}

import Argparse.Parser as AP
import Argparse.PrettyPrinter as PP
import Argparse.Program as Program
import Bytes exposing (Bytes)
import Dict
import FileSystem
import FileSystem.Path as Path exposing (Path)
import Init
import Node
import Stream.Log
import Task exposing (Task)
import Terminal
import Test.Runner.UnitNode.Internal as I exposing (Suite(..), SuiteResult, Selection)
import Test.Runner.UnitNode.JUnit as JUnit
import Test.Runner.UnitNode.Glob as Glob
import Test.Runner.UnitNode.Report as Report


type alias Flags =
    { patterns : Array String
    , verbose : Bool
    , list : Bool
    , junitXml : Maybe Path
    }


type alias Context perms =
    { perms : perms
    , fs : FileSystem.Permission
    , useColor : Bool
    }


{-| Run the test suite with no permissions. Use this when your tests are
purely computational and need no filesystem, network, or process access.
For tests that need resources, use [runWith](#runWith).
-}
run :
    { name : String
    , version : String
    , suites : Array Suite
    }
    -> Node.SimpleProgram a
run userConfig =
    runWith
        { name = userConfig.name
        , version = userConfig.version
        , init = \done -> done {}
        , globalSetUp = \_ -> Task.succeed {}
        , globalTearDown = \_ -> Task.succeed {}
        , suites = \_ -> userConfig.suites
        }


{-| Run the test suite with a custom initialization step. Use this when you
need permissions beyond — or instead of — the `fs + childProcess` pair that
`run` provides.

The `init` argument follows the same continuation pattern as `Init.await`:
call `done` with whatever permissions your tests need.

    U.runWith
        { name = "my-tests"
        , version = "1.0.0"
        , init =
            \done ->
                Init.await HttpClient.initialize <| \http ->
                    done { http = http }
        , suites = \perms -> [ mySuite perms ]
        }

For no permissions at all:

    init = \done -> done {}

Note: the framework always acquires `FileSystem.Permission` for itself (to
support `--junit-xml`). If your tests also need filesystem access, acquire it
separately in your `init`.
-}
runWith :
    { name : String
    , version : String
    , init : (perms -> Init.Task (Cmd a)) -> Init.Task (Cmd a)
    , globalSetUp : perms -> Task String {}
    , globalTearDown : perms -> Task String {}
    , suites : perms -> Array Suite
    }
    -> Node.SimpleProgram a
runWith userConfig =
    Program.runRootWithContext
        { name = userConfig.name
        , version = userConfig.version
        , command = command
        , init = \_env toProgram ->
            Init.await FileSystem.initialize <|
                \fs ->
                    Init.await Terminal.initialize <|
                        \termConfig ->
                            Init.awaitTask Node.getEnvironmentVariables <|
                                \envVars ->
                                    userConfig.init <|
                                        \userPerms ->
                                            toProgram
                                                { perms = userPerms
                                                , fs = fs
                                                , useColor = termConfig /= Nothing && not (Dict.member "NO_COLOR" envVars)
                                                }
        , onCommand = onCommand userConfig.suites userConfig.globalSetUp userConfig.globalTearDown
        }


command : AP.Command (Array String) Flags Flags
command =
    { word = ""
    , arguments = AP.zeroOrMoreArgs
            { value = stringParser
            , help = "Glob pattern(s) selecting tests by qualified name (Suite.test). Omit to run all."
            }
    , flags = AP.initFlags
            (\verbose list junitXml ->
                { patterns = [], verbose = verbose, list = list, junitXml = junitXml }
            )
            |> AP.toggle (AP.Both { long = "verbose", short = "v" }) "Show per-test status and execution time"
            |> AP.toggle (AP.Both { long = "list", short = "l" }) "List every test's qualified name and exit"
            |> AP.flag (AP.LongOnly "junit-xml") AP.pathParser "Write JUnit XML results to the given path"
    , commonDescription = Nothing
    , summary = "Run the test suite."
    , example = PP.empty
    , builder = \args flags -> { flags | patterns = args }
    }


stringParser : AP.ValueParser String
stringParser =
    { label = "pattern"
    , fn = Just
    , examples = [ "Format.*", "*in place*" ]
    }


onCommand : (perms -> Array Suite) -> (perms -> Task String {}) -> (perms -> Task String {}) -> Node.Environment -> Context perms -> Flags -> Task Program.Failure {}
onCommand buildSuites globalSetUp globalTearDown env ctx flags =
    let
        suites =
            buildSuites ctx.perms

        selection =
            selectionFrom flags.patterns

        style =
            if flags.verbose then
                Report.Verbose

            else
                Report.Plain
    in
    if flags.list then
        listTests env suites
            |> Task.map (\_ -> {})

    else
        globalSetUp ctx.perms
            |> Task.mapError (\e -> Program.ExitMessage ("globalSetUp: " ++ e))
            |> Task.andThen
                (\_ ->
                    runAll env ctx style suites selection
                        |> Task.onError never
                        |> Task.andThen
                            (\suiteResults ->
                                reportAndWrite env ctx style flags suiteResults
                                    |> Task.mapError Program.ExitMessage
                                    |> Task.andThen
                                        (\_ ->
                                            globalTearDown ctx.perms
                                                |> Task.mapError (\e -> Program.ExitMessage ("globalTearDown: " ++ e))
                                        )
                                    |> Task.andThen (\_ -> outcomeFor suiteResults)
                            )
                )


selectionFrom : Array String -> Selection
selectionFrom patterns =
    { isSelected = \fullName ->
        if Array.isEmpty patterns then
            True

        else
            Array.any (\p -> Glob.matches p fullName) patterns }


{-| Run every suite in order, printing each body line as soon as it is known
rather than buffering the whole report to the end — on a suite that takes
seconds, the point is seeing progress while it happens.

In `Verbose` the reporter prints a line per test from inside the runner; each
suite then closes its block with the same rollup line `Plain` uses, followed by
a blank line. In `Plain` only the rollup is printed. Because the line renderers
are pure functions of one result, the streamed output is byte-identical to what
rendering at the end produced.
-}
runAll : Node.Environment -> Context perms -> Report.Style -> Array Suite -> Selection -> Task Never (Array SuiteResult)
runAll env ctx style suites selection =
    let
        reporter =
            when style is
                Report.Verbose ->
                    { onTestDone = \r -> logLine env (Report.verboseLine ctx.useColor r) }

                Report.Plain ->
                    I.silentReporter
    in
    Array.foldl
        (\(Suite s) acc ->
            acc
                |> Task.andThen
                    (\soFar ->
                        s.run selection reporter
                            |> Task.andThen
                                (\r ->
                                    endSuiteBlock env ctx style r
                                        |> Task.map (\_ -> Array.pushLast r soFar)
                                )
                    )
        )
        (Task.succeed [])
        suites


{-| Close out one suite's body. `Verbose` appends a trailing blank line to
separate the block from the next suite's tests; a suite that ran nothing (every
test deselected by a glob) prints no rollup there, since there is no block for
it to close. `Plain` prints its line unconditionally, including the `0/0` line
for a fully-deselected suite, as it always has.
-}
endSuiteBlock : Node.Environment -> Context perms -> Report.Style -> SuiteResult -> Task Never {}
endSuiteBlock env ctx style r =
    when style is
        Report.Plain ->
            logLine env (Report.suiteLine ctx.useColor r)

        Report.Verbose ->
            if Array.isEmpty r.results then
                Task.succeed {}

            else
                logLine env (Report.suiteLine ctx.useColor r ++ "\n")


logLine : Node.Environment -> String -> Task Never {}
logLine env text =
    Stream.Log.line env.stdout text


{-| Print the end-of-run tail (failure details + summary), then optionally write
the JUnit XML. The body is already on screen, streamed by `runAll`, so all this
adds is the two blank lines that used to come from `render`'s section join.
-}
reportAndWrite : Node.Environment -> Context perms -> Report.Style -> Flags -> Array SuiteResult -> Task String {}
reportAndWrite env ctx style flags suiteResults =
    let
        reportText =
            tailSeparator style suiteResults
                ++ Report.tail { useColor = ctx.useColor } suiteResults
    in
    Stream.Log.line env.stdout reportText
        |> Task.andThen
            (\_ ->
                when flags.junitXml is
                    Just path ->
                        FileSystem.writeFile ctx.fs (bytesOf (JUnit.toXmlString suiteResults)) path
                            |> Task.map (\_ -> {})
                            |> Task.mapError (\e -> "could not write JUnit XML: " ++ Debug.toString e)

                    Nothing ->
                        Task.succeed {}
            )


{-| The blank lines between the streamed body and the tail, reproducing the
`"\n\n\n"` that `Report.render` used to put between its sections. `Verbose`
needs one fewer because `endSuiteBlock` already emitted a blank after the last
block; if nothing was printed at all (a glob that matched no test), the tail
leads the output and needs none.
-}
tailSeparator : Report.Style -> Array SuiteResult -> String
tailSeparator style suiteResults =
    when style is
        Report.Plain ->
            if Array.isEmpty suiteResults then
                ""

            else
                "\n\n"

        Report.Verbose ->
            if Array.any (\r -> not (Array.isEmpty r.results)) suiteResults then
                "\n"

            else
                ""


listTests : Node.Environment -> Array Suite -> Task x {}
listTests env suites =
    suites
        |> Array.foldl (\(Suite s) acc -> acc ++ s.testNames) []
        |> String.join "\n"
        |> Stream.Log.line env.stdout


outcomeFor : Array SuiteResult -> Task Program.Failure {}
outcomeFor suiteResults =
    let
        anyBad =
            Array.any
                (\sr ->
                    sr.suiteError /= Nothing
                        || Array.any (\r -> I.outcomeIsBad r.outcome) sr.results
                )
                suiteResults
    in
    if anyBad then
        Task.fail Program.ExitFailure

    else
        Task.succeed {}


bytesOf : String -> Bytes
bytesOf s =
    Bytes.fromString s
